DEEPL_API_KEY=replace-with-your-key
DEEPL_API_BASE_URL=https://api-free.deepl.com/v2

# Password reset security. Generate a high-entropy value and keep it secret.
PASSWORD_RESET_HMAC_KEY=

# Mailtrap transactional API delivery for password reset codes.
Mailtrap__ApiToken=
Mailtrap__Endpoint=https://send.api.mailtrap.io/api/send
Mailtrap__FromEmail=no-reply@spellstack.dev
Mailtrap__FromName=SpellStack
