*.user
*.suo
.vs/
.vscode/

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Uploaded profile images
**/wwwroot/uploads/profile-images/*
!**/wwwroot/uploads/profile-images/.gitkeep

# Uploaded custom audio
**/wwwroot/uploads/audio/login-splash/*
!**/wwwroot/uploads/audio/login-splash/.gitkeep
**/wwwroot/uploads/audio/main-menu/*
!**/wwwroot/uploads/audio/main-menu/.gitkeep
